<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FixtureData.cs" Link="FixtureData.cs" />
    <Content Include="../fixtures/flat-winding-region.json;../fixtures/witnesses.json" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../shared/Core/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Rhino/BuildingPlacement.cs;../../shared/Rhino/PlanarTriangulation.cs;../../shared/Rhino/PlanarPartition.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Rhino/TopoObjectInfo.cs" Link="Shared/TopoObjectInfo.cs" />
    <Compile Include="../../../info/shared/InfoData.cs" Link="Info/InfoData.cs" />
    <Compile Include="../../api/rhino/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>
</Project>
